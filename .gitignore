# 1. Dependencies (Massive folders, do not push)
node_modules/

# 2. Environment Variables (CRITICAL: Contains your secrets and passwords)
.env
.env.local
.env.*.local

# 3. Build Outputs (Auto-generated files)
/server/dist/
/client/.next/
/client/out/
build/

# 4. Logs (Error tracking files generated by npm)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# 5. OS & Editor Files (Junk files created by Windows/Mac or VS Code)
.DS_Store
Thumbs.db
.vscode/
.idea/